pragma solidity ^0.8.24;

import {KB8} from "./KB8.sol";
import {FastTranscript} from "./FastTranscript.sol";
import {SpendConstants} from "./SpendConstants.sol";

// Verifier for the Ostra Swap spend circuit (circuit/src/lib.rs, Plonky3 0.8.0): KoalaBear with the
// degree-8 extension, HidingFriPcs (log_blowup 6, arity 4, final polynomial 16, 19 queries, 8 random
// codewords, batch grinding 10 bits, query grinding 16 bits), Keccak-256 hiding Merkle commitments,
// and the spend AIR: 2^7 rows of 192 columns (one Poseidon2 permutation per row plus link, balance
// and range-check columns), 8 periodic selectors, 48 public values, constraints on the current and
// the next row.
//
// It follows p3_uni_stark::verify, HidingFriPcs::verify_with_preprocessing, TwoAdicFriPcs::verify and
// p3_fri::verifier::verify_fri step for step. The proof arrives in the flat layout of
// circuit/src/flat.rs, whose decoder rebuilds the Plonky3 proof byte for byte. Every number that fixes
// the shape comes from the configuration (SpendConstants, generated by Plonky3), never from the proof.
//
// Rewritings of Plonky3's arithmetic, all exact in the field:
//   - The trace is opened at zeta and at zeta * g, everything else at zeta, all on matrices of one
//     height; so the reduced opening of a query is (S_z - R_z) / (zeta - x) + (S_n - R_n) / (zeta g - x),
//     where S sums alpha^k p_k(point) over the claims at that point and R sums alpha^k p_k(x) over the
//     same ladder positions, in Plonky3's ladder order.
//   - Periodic selectors are evaluated at zeta with the Lagrange basis of the trace subgroup
//     (L_r(zeta) = g^r / N * (zeta^N - 1) / (zeta - g^r)), which is the interpolation Plonky3 runs.
//   - An arity-4 fold evaluates the interpolant through the four coset points with a size-4 inverse
//     DFT; s^-1 and g^rev(i) come from tables of g^(2^k); sums of products are accumulated unreduced
//     with bounds stated where they are formed.
//
// Deliberate differences, none of which accepts a proof Plonky3 rejects:
//   - Duplicate queries of one Merkle leaf are compared by leaf digest instead of row by row.
//   - The flat layout cannot carry what Plonky3 would reject on decoding (non-canonical elements, wrong
//     lengths) or the grinding witnesses of zero-bit phases (Plonky3 accepts only zero there).
//   - Commitments are single roots (cap height 0); the trace height is fixed.
//   - verify reverts instead of returning false on conditions no layout-conforming proof reaches;
//     callers treat a revert as a rejection.
//
// The verifier reads calldata past the end of a short proof as zeros; the length checks (sibling
// counts against the proof length, and the final cursor == length) reject any such proof.
contract SpendVerifier {
    using FastTranscript for FastTranscript.State;

    uint256 internal constant P = 2130706433;
    uint256 internal constant TRACE_WIDTH = 192;
    uint256 internal constant NUM_PUBLIC = 48;
    uint256 internal constant NUM_PERIODIC = 8;
    uint256 internal constant LOG_ROWS = 7;
    uint256 internal constant QUERIES = 19;
    uint256 internal constant LOG_BLOWUP = 6;
    // Committed trace height 2^8 (the zero-knowledge extension doubles 2^7), LDE height 2^14.
    uint256 internal constant H = 14;
    uint256 internal constant LOG_FINAL_HEIGHT = 10;
    uint256 internal constant FINAL_POLY_LEN = 16;
    uint256 internal constant CHUNKS = 8;
    // Trace matrix width with its random-codeword columns; claims in ladder order: random (16), trace at
    // zeta (WD), trace at zeta g (WD), quotient chunks (8 x 16).
    uint256 internal constant WD = TRACE_WIDTH + 8;
    uint256 internal constant N_START = 16 + WD;
    uint256 internal constant N_END = 16 + 2 * WD;
    uint256 internal constant CLAIMS = 16 + 2 * WD + CHUNKS * 16;
    uint256 internal constant BATCH_POW_BITS = 10;
    uint256 internal constant QUERY_POW_BITS = 16;
    uint256 internal constant SALT = 4;
    // 1/2 and 1/4 in the base field (P = 1 mod 4).
    uint256 internal constant INV2 = (P + 1) / 2;
    uint256 internal constant INV4 = (3 * P + 1) / 4;

    // Offsets in the flat proof.
    uint256 internal constant O_TRACE = 0;
    uint256 internal constant O_QUOT = 32;
    uint256 internal constant O_RAND = 64;
    uint256 internal constant O_TL = 96;
    uint256 internal constant O_TN = O_TL + TRACE_WIDTH * 32;
    uint256 internal constant O_QC = O_TN + TRACE_WIDTH * 32;
    uint256 internal constant O_RV = O_QC + 64 * 32;
    uint256 internal constant O_RCW = O_RV + 8 * 32;
    uint256 internal constant O_BPW = O_RCW + 88 * 32;
    uint256 internal constant O_COMMITS = O_BPW + 4;

    struct Ctx {
        uint256 base;
        uint256 len;
        uint256 rounds;
        uint256 arities;
        uint256 alpha;
        uint256 zeta;
        uint256 zp;
        uint256 pcsAlpha;
        uint256 cursor;
        uint256 finalOffset;
        uint256[] pv;
        uint256[] betas;
        uint256[] indices;
        uint256[] claims;
        uint256[] folded;
        uint256[] topTable;
        uint256[25] gens;
    }

    // True when proof is a valid spend proof for these 48 public values (each below P), in the order of
    // circuit/src/lib.rs: asset (6), v (5), fee (5), nullifier (8), root (8), change commitment (8),
    // bind (8).
    function verify(bytes calldata proof, uint256[48] calldata publicValues) external view returns (bool) {
        Ctx memory c;
        uint256 o;
        assembly {
            o := proof.offset
        }
        c.base = o;
        c.len = proof.length;
        if (c.len < O_COMMITS) return false;
        c.pv = new uint256[](NUM_PUBLIC);
        for (uint256 i = 0; i < NUM_PUBLIC; i++) {
            if (publicValues[i] >= P) return false;
            c.pv[i] = publicValues[i];
        }
        c.rounds = SpendConstants.ROUNDS;
        c.arities = SpendConstants.ARITIES;
        c.gens = SpendConstants.twoAdicGenerators();
        if (!transcript(c)) return false;
        if (!openInputs(c)) return false;
        if (!fri(c)) return false;
        if (c.cursor != c.len) return false;
        return constraintsHold(c);
    }

    // ---------------------------------------------------------------- calldata

    function ld16(Ctx memory c, uint256 o) internal pure returns (uint256 v) {
        uint256 a = c.base + o;
        assembly {
            v := shr(240, calldataload(a))
        }
    }

    function ld32(Ctx memory c, uint256 o) internal pure returns (uint256 v) {
        uint256 a = c.base + o;
        assembly {
            v := shr(224, calldataload(a))
        }
    }

    function ldWord(Ctx memory c, uint256 o) internal pure returns (bytes32 v) {
        uint256 a = c.base + o;
        assembly {
            v := calldataload(a)
        }
    }

    function ldExt(Ctx memory c, uint256 o) internal pure returns (uint256 v) {
        uint256 a = c.base + o;
        assembly {
            v := calldataload(a)
        }
    }

    // ---------------------------------------------------------------- base field helpers

    // t[i] = g^(2^(bits - 1 - i)), so that g^rev(x, bits) is the product of t[i] over the set bits i of x.
    function revPowTable(uint256 g, uint256 bits) internal pure returns (uint256[] memory t) {
        t = new uint256[](bits);
        assembly {
            let q := 2130706433
            let base := add(t, 32)
            for { let k := 0 } lt(k, bits) { k := add(k, 1) } {
                mstore(add(base, shl(5, sub(sub(bits, 1), k))), g)
                g := mulmod(g, g, q)
            }
        }
    }

    // g^rev(x, bits) from revPowTable(g, bits); x must be below 2^bits.
    function revPow(uint256[] memory t, uint256 x) internal pure returns (uint256 r) {
        assembly {
            let q := 2130706433
            let base := add(t, 32)
            let n := mload(t)
            r := 1
            for { let i := 0 } lt(i, n) { i := add(i, 1) } {
                if and(shr(i, x), 1) { r := mulmod(r, mload(add(base, shl(5, i))), q) }
            }
        }
    }

    // ---------------------------------------------------------------- transcript

    function absorbClaims(Ctx memory c, FastTranscript.State memory t, uint256 o, uint256 n, uint256 k)
        internal
        pure
        returns (bool, uint256)
    {
        for (uint256 i = 0; i < n; i++) {
            uint256 e = ldExt(c, o + 32 * i);
            if (!t.observeExt(e)) return (false, k);
            c.claims[k++] = e;
        }
        return (true, k);
    }

    // p3_uni_stark::verify's transcript (StarkVerifierTranscript), then the PCS's (PcsVerifierTranscript)
    // and FRI's (VerifierTranscript), each seeded from its own shape.
    function transcript(Ctx memory c) internal pure returns (bool) {
        FastTranscript.State memory t = FastTranscript.init();
        return starkPhase(c, t) && pcsPhase(c, t) && friPhase(c, t);
    }

    // zeta must lie off the initial trace domain (2^7 points): Z_H(zeta) = zeta^(2^7) - 1 != 0.
    function offDomain(uint256 zp) internal pure returns (bool) {
        return zp != 1;
    }

    // Seed, trace commitment, the public values (as field elements), alpha; quotient and random
    // commitments, zeta.
    function starkPhase(Ctx memory c, FastTranscript.State memory t) internal pure returns (bool) {
        t.observeMemory(SpendConstants.SEED_STARK);
        t.observeCalldata(c.base + O_TRACE, 32);
        for (uint256 i = 0; i < NUM_PUBLIC; i++) {
            t.observeField(c.pv[i]);
        }
        c.alpha = t.sampleExt();
        t.observeCalldata(c.base + O_QUOT, 32);
        t.observeCalldata(c.base + O_RAND, 32);
        c.zeta = t.sampleExt();
        c.zp = KB8.pow2k(c.zeta, LOG_ROWS);
        return offDomain(c.zp);
    }

    // Claimed evaluations in claim order: random; trace at zeta; trace at zeta g; quotient chunks. Each
    // opening's values, then its 8 random-codeword values (HidingFriPcs appends them). Then the batch
    // grinding and alpha.
    function pcsPhase(Ctx memory c, FastTranscript.State memory t) internal pure returns (bool ok) {
        t.observeMemory(SpendConstants.SEED_PCS);
        c.claims = new uint256[](CLAIMS);
        uint256 k = 0;
        (ok, k) = absorbClaims(c, t, O_RV, 8, k);
        if (!ok) return false;
        (ok, k) = absorbClaims(c, t, O_RCW, 8, k);
        if (!ok) return false;
        (ok, k) = absorbClaims(c, t, O_TL, TRACE_WIDTH, k);
        if (!ok) return false;
        (ok, k) = absorbClaims(c, t, O_RCW + 8 * 32, 8, k);
        if (!ok) return false;
        (ok, k) = absorbClaims(c, t, O_TN, TRACE_WIDTH, k);
        if (!ok) return false;
        (ok, k) = absorbClaims(c, t, O_RCW + 16 * 32, 8, k);
        if (!ok) return false;
        for (uint256 m = 0; m < CHUNKS; m++) {
            (ok, k) = absorbClaims(c, t, O_QC + m * 256, 8, k);
            if (!ok) return false;
            (ok, k) = absorbClaims(c, t, O_RCW + (24 + 8 * m) * 32, 8, k);
            if (!ok) return false;
        }
        uint256 w = ld32(c, O_BPW);
        if (w >= P || !t.checkWitness(BATCH_POW_BITS, w)) return false;
        c.pcsAlpha = t.sampleExt();
        return true;
    }

    // Commit rounds (commitment, beta), the final polynomial, the query grinding and the indices.
    function friPhase(Ctx memory c, FastTranscript.State memory t) internal pure returns (bool) {
        t.observeMemory(SpendConstants.SEED_FRI);
        c.betas = new uint256[](c.rounds);
        for (uint256 r = 0; r < c.rounds; r++) {
            t.observeCalldata(c.base + O_COMMITS + 32 * r, 32);
            c.betas[r] = t.sampleExt();
        }
        c.finalOffset = O_COMMITS + 32 * c.rounds;
        for (uint256 i = 0; i < FINAL_POLY_LEN; i++) {
            if (!t.observeExt(ldExt(c, c.finalOffset + 32 * i))) return false;
        }
        uint256 w = ld32(c, c.finalOffset + 32 * FINAL_POLY_LEN);
        if (w >= P || !t.checkWitness(QUERY_POW_BITS, w)) return false;
        c.indices = new uint256[](QUERIES);
        for (uint256 q = 0; q < QUERIES; q++) {
            c.indices[q] = t.sampleBits(H);
        }
        c.cursor = c.finalOffset + 32 * FINAL_POLY_LEN + 4;
        return true;
    }

    // ---------------------------------------------------------------- hiding Merkle, from calldata

    // Leaf preimage of the hiding MMCS (MerkleTreeHidingMmcs, SerializingHasher<Keccak256Hash>): every
    // element as the 4 little-endian bytes of its Montgomery form. Reads n canonical 4-byte big-endian
    // values at calldata address src, writes 4n bytes at memory address dst; false on a value >= P.
    function montBlock(uint256 src, uint256 n, uint256 dst) internal pure returns (bool ok) {
        assembly {
            let bad := 0
            let full := shl(5, shr(3, n))
            // Eight elements per word: the range check and the byte swap run on all lanes at once
            // (lane >= P sets bit 32 of lane + 2^32 - P in a 64-bit field; bytes swap within 16-bit,
            // then 16-bit halves within 32-bit lanes).
            for { let i := 0 } lt(i, full) { i := add(i, 32) } {
                let x := calldataload(add(src, i))
                bad := or(bad, and(or(add(and(x, 0x00000000ffffffff00000000ffffffff00000000ffffffff00000000ffffffff), 0x0000000080ffffff0000000080ffffff0000000080ffffff0000000080ffffff), add(and(shr(32, x), 0x00000000ffffffff00000000ffffffff00000000ffffffff00000000ffffffff), 0x0000000080ffffff0000000080ffffff0000000080ffffff0000000080ffffff)), 0x0000000100000000000000010000000000000001000000000000000100000000))
                let w := 0
                w := or(w, shl(224, mulmod(shr(224, x), 33554430, 2130706433)))
                w := or(w, shl(192, mulmod(and(shr(192, x), 0xffffffff), 33554430, 2130706433)))
                w := or(w, shl(160, mulmod(and(shr(160, x), 0xffffffff), 33554430, 2130706433)))
                w := or(w, shl(128, mulmod(and(shr(128, x), 0xffffffff), 33554430, 2130706433)))
                w := or(w, shl(96, mulmod(and(shr(96, x), 0xffffffff), 33554430, 2130706433)))
                w := or(w, shl(64, mulmod(and(shr(64, x), 0xffffffff), 33554430, 2130706433)))
                w := or(w, shl(32, mulmod(and(shr(32, x), 0xffffffff), 33554430, 2130706433)))
                w := or(w, mulmod(and(x, 0xffffffff), 33554430, 2130706433))
                w := or(shl(8, and(w, 0x00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff)), and(shr(8, w), 0x00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff))
                w := or(shl(16, and(w, 0x0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff)), and(shr(16, w), 0x0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff))
                mstore(add(dst, i), w)
            }
            // The remaining elements one by one.
            for { let i := full } lt(i, shl(2, n)) { i := add(i, 4) } {
                let v := shr(224, calldataload(add(src, i)))
                bad := or(bad, gt(v, 2130706432))
                let m := mulmod(v, 33554430, 2130706433)
                mstore(add(dst, i), shl(224, or(or(shl(24, and(m, 0xff)), shl(8, and(m, 0xff00))), or(and(shr(8, m), 0xff00), shr(24, m)))))
            }
            ok := iszero(bad)
        }
    }

    // The 8 coefficients of a packed extension element, coefficient 0 first, in the same encoding:
    // Montgomery form per lane, then the whole word byte-reversed (lane order and byte order at once).
    function montExt(uint256 e, uint256 dst) internal pure {
        assembly {
            let m := mulmod(and(e, 0xffffffff), 33554430, 2130706433)
            m := or(m, shl(32, mulmod(and(shr(32, e), 0xffffffff), 33554430, 2130706433)))
            m := or(m, shl(64, mulmod(and(shr(64, e), 0xffffffff), 33554430, 2130706433)))
            m := or(m, shl(96, mulmod(and(shr(96, e), 0xffffffff), 33554430, 2130706433)))
            m := or(m, shl(128, mulmod(and(shr(128, e), 0xffffffff), 33554430, 2130706433)))
            m := or(m, shl(160, mulmod(and(shr(160, e), 0xffffffff), 33554430, 2130706433)))
            m := or(m, shl(192, mulmod(and(shr(192, e), 0xffffffff), 33554430, 2130706433)))
            m := or(m, shl(224, mulmod(and(shr(224, e), 0xffffffff), 33554430, 2130706433)))
            m := or(shl(8, and(m, 0x00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff)), and(shr(8, m), 0x00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff00ff))
            m := or(shl(16, and(m, 0x0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff)), and(shr(16, m), 0x0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff0000ffff))
            m := or(shl(32, and(m, 0x00000000ffffffff00000000ffffffff00000000ffffffff00000000ffffffff)), and(shr(32, m), 0x00000000ffffffff00000000ffffffff00000000ffffffff00000000ffffffff))
            m := or(shl(64, and(m, 0x0000000000000000ffffffffffffffff0000000000000000ffffffffffffffff)), and(shr(64, m), 0x0000000000000000ffffffffffffffff0000000000000000ffffffffffffffff))
            m := or(shl(128, m), shr(128, m))
            mstore(dst, m)
        }
    }

    // Distinct leaves ascending. Duplicate queries of one leaf must open the same row; equal leaf
    // digests stand for equal rows (Keccak-256 collision resistance).
    function sortLeaves(uint256[] memory idx, bytes32[] memory leaf, uint256 logH)
        internal
        pure
        returns (bool, uint256[] memory node, bytes32[] memory dig, uint256 nu)
    {
        uint256 nq = idx.length;
        node = new uint256[](nq);
        dig = new bytes32[](nq);
        for (uint256 q = 0; q < nq; q++) {
            uint256 at = idx[q];
            if (at >> logH != 0) return (false, node, dig, nu);
            uint256 pos = 0;
            while (pos < nu && node[pos] < at) pos++;
            if (pos < nu && node[pos] == at) {
                if (dig[pos] != leaf[q]) return (false, node, dig, nu);
                continue;
            }
            for (uint256 k = nu; k > pos; k--) {
                node[k] = node[k - 1];
                dig[k] = dig[k - 1];
            }
            node[pos] = at;
            dig[pos] = leaf[q];
            nu++;
        }
        return (true, node, dig, nu);
    }

    struct Frontier {
        uint256[] node;
        bytes32[] dig;
        uint256 nu;
        uint256 sib;
        uint256 nsib;
        uint256 cursor;
    }

    // One level of walk_pruned_frontier: a node pairs with its sibling in the frontier, or takes the next
    // pruned sibling (nsib digests at calldata address sib).
    function walkLevel(Frontier memory f) internal pure returns (bool ok) {
        uint256[] memory node = f.node;
        bytes32[] memory dig = f.dig;
        uint256 nu = f.nu;
        uint256 sib = f.sib;
        uint256 nsib = f.nsib;
        uint256 cursor = f.cursor;
        assembly {
            ok := 1
            let np := add(node, 32)
            let dp := add(dig, 32)
            let g := 0
            let i := 0
            for {} lt(i, nu) {} {
                let ni := mload(add(np, shl(5, i)))
                let parent := shr(1, ni)
                let paired := 0
                if lt(add(i, 1), nu) {
                    paired := eq(shr(1, mload(add(np, shl(5, add(i, 1))))), parent)
                }
                switch paired
                case 1 {
                    mstore(0x00, mload(add(dp, shl(5, i))))
                    mstore(0x20, mload(add(dp, shl(5, add(i, 1)))))
                    i := add(i, 2)
                }
                default {
                    if iszero(lt(cursor, nsib)) {
                        ok := 0
                        i := nu
                    }
                    if ok {
                        let sb := calldataload(add(sib, shl(5, cursor)))
                        cursor := add(cursor, 1)
                        switch and(ni, 1)
                        case 0 {
                            mstore(0x00, mload(add(dp, shl(5, i))))
                            mstore(0x20, sb)
                        }
                        default {
                            mstore(0x00, sb)
                            mstore(0x20, mload(add(dp, shl(5, i))))
                        }
                        i := add(i, 1)
                    }
                }
                if ok {
                    mstore(add(np, shl(5, g)), parent)
                    mstore(add(dp, shl(5, g)), keccak256(0x00, 0x40))
                    g := add(g, 1)
                }
            }
            nu := g
        }
        f.nu = nu;
        f.cursor = cursor;
    }

    // verify_multi_batch of the hiding MMCS (cap height 0, binary) when every committed matrix has the
    // same height 2^logH, as walk_pruned_frontier runs it: the root must be the one node left after
    // logH levels, and every pruned sibling must be used.
    function merklePow2(bytes32 root, uint256 logH, uint256[] memory idx, bytes32[] memory leaf, uint256 sib, uint256 nsib)
        internal
        pure
        returns (bool)
    {
        Frontier memory f;
        bool sorted;
        (sorted, f.node, f.dig, f.nu) = sortLeaves(idx, leaf, logH);
        if (!sorted) return false;
        f.sib = sib;
        f.nsib = nsib;
        for (uint256 level = 0; level < logH; level++) {
            if (!walkLevel(f)) return false;
        }
        return f.nu == 1 && f.node[0] == 0 && f.dig[0] == root && f.cursor == nsib;
    }

    // ---------------------------------------------------------------- input openings

    // Powers of the PCS batching challenge alpha^k for the 544 claimed columns, each spread into 3 words
    // with its coefficients 85 bits apart ((0, 1, 2), (3, 4, 5), (6, 7)), so a base element scales
    // three coefficients per MUL; products stay below 2^62 and sums over a query's rows (at most 344
    // terms per accumulator) below 2^71. The same pass accumulates S_z = sum alpha^k p_k(zeta) and
    // S_n = sum alpha^k p_k(zeta g) (ladder positions N_START..N_END) by Kronecker substitution (as
    // KB8.mul, with X = 2^76: at most 344 terms per sum keep every field below 2^75), each reduced once.
    function ladder(uint256 a, uint256[] memory claims) internal pure returns (uint256[] memory w, uint256 sz, uint256 sn) {
        w = new uint256[](3 * CLAIMS);
        uint256[7] memory saccZ;
        uint256[7] memory saccN;
        uint256 p = 1;
        for (uint256 k = 0; k < CLAIMS; k++) {
            uint256 v = claims[k];
            uint256[7] memory sacc = (k >= N_START && k < N_END) ? saccN : saccZ;
            assembly {
                let d := add(add(w, 32), mul(96, k))
                mstore(d, or(or(and(p, 0xffffffff), shl(85, and(shr(32, p), 0xffffffff))), shl(170, and(shr(64, p), 0xffffffff))))
                mstore(add(d, 32), or(or(and(shr(96, p), 0xffffffff), shl(85, and(shr(128, p), 0xffffffff))), shl(170, and(shr(160, p), 0xffffffff))))
                mstore(add(d, 64), or(and(shr(192, p), 0xffffffff), shl(85, shr(224, p))))
                let A0 := or(and(p, 0xffffffff), shl(76, and(shr(32, p), 0xffffffff)))
                let A1 := or(and(shr(64, p), 0xffffffff), shl(76, and(shr(96, p), 0xffffffff)))
                let A2 := or(and(shr(128, p), 0xffffffff), shl(76, and(shr(160, p), 0xffffffff)))
                let A3 := or(and(shr(192, p), 0xffffffff), shl(76, shr(224, p)))
                let B0 := or(and(v, 0xffffffff), shl(76, and(shr(32, v), 0xffffffff)))
                let B1 := or(and(shr(64, v), 0xffffffff), shl(76, and(shr(96, v), 0xffffffff)))
                let B2 := or(and(shr(128, v), 0xffffffff), shl(76, and(shr(160, v), 0xffffffff)))
                let B3 := or(and(shr(192, v), 0xffffffff), shl(76, shr(224, v)))
                mstore(add(sacc, 0), add(mload(add(sacc, 0)), mul(A0, B0)))
                mstore(add(sacc, 32), add(mload(add(sacc, 32)), add(mul(A0, B1), mul(A1, B0))))
                mstore(add(sacc, 64), add(mload(add(sacc, 64)), add(add(mul(A0, B2), mul(A1, B1)), mul(A2, B0))))
                mstore(add(sacc, 96), add(mload(add(sacc, 96)), add(add(add(mul(A0, B3), mul(A1, B2)), mul(A2, B1)), mul(A3, B0))))
                mstore(add(sacc, 128), add(mload(add(sacc, 128)), add(add(mul(A1, B3), mul(A2, B2)), mul(A3, B1))))
                mstore(add(sacc, 160), add(mload(add(sacc, 160)), add(mul(A2, B3), mul(A3, B2))))
                mstore(add(sacc, 192), add(mload(add(sacc, 192)), mul(A3, B3)))
            }
            p = KB8.mul(p, a);
        }
        sz = kroneckerReduce(saccZ);
        sn = kroneckerReduce(saccN);
    }

    // r from the seven Kronecker sums S_0..S_6 (fields of 76 bits), as at the end of KB8.mul.
    function kroneckerReduce(uint256[7] memory sacc) internal pure returns (uint256 r) {
        assembly {
            let q := 2130706433
            let F := 0xfffffffffffffffffff
            let s3 := mload(add(sacc, 96))
            let t := add(mload(sacc), mul(3, mload(add(sacc, 128))))
            r := or(mod(add(and(t, F), mul(3, shr(152, s3))), q), shl(32, mod(and(shr(76, t), F), q)))
            let carry := shr(152, t)
            t := add(mload(add(sacc, 32)), mul(3, mload(add(sacc, 160))))
            r := or(r, or(shl(64, mod(add(and(t, F), carry), q)), shl(96, mod(and(shr(76, t), F), q))))
            carry := shr(152, t)
            t := add(mload(add(sacc, 64)), mul(3, mload(add(sacc, 192))))
            r := or(r, or(shl(128, mod(add(and(t, F), carry), q)), shl(160, mod(and(shr(76, t), F), q))))
            carry := shr(152, t)
            r := or(r, or(shl(192, mod(add(and(s3, F), carry), q)), shl(224, mod(and(shr(76, s3), F), q))))
        }
    }

    // acc += sum_i alpha^(k0 + i) * row[i] for n base values at calldata address src (already checked
    // canonical by montBlock), accumulated unreduced in the 3-word spread form of ladder().
    function dotWide(uint256[] memory w, uint256 k0, uint256 src, uint256 n, uint256[3] memory acc) internal pure {
        assembly {
            let wp := add(add(w, 32), mul(96, k0))
            let a0 := mload(acc)
            let a1 := mload(add(acc, 32))
            let a2 := mload(add(acc, 64))
            let end := add(src, shl(2, shl(3, shr(3, n))))
            for {} lt(src, end) { src := add(src, 32) } {
                let x := calldataload(src)
                {
                    let v := shr(224, x)
                    let p := add(wp, 0)
                    a0 := add(a0, mul(mload(p), v))
                    a1 := add(a1, mul(mload(add(p, 32)), v))
                    a2 := add(a2, mul(mload(add(p, 64)), v))
                }
                {
                    let v := and(shr(192, x), 0xffffffff)
                    let p := add(wp, 96)
                    a0 := add(a0, mul(mload(p), v))
                    a1 := add(a1, mul(mload(add(p, 32)), v))
                    a2 := add(a2, mul(mload(add(p, 64)), v))
                }
                {
                    let v := and(shr(160, x), 0xffffffff)
                    let p := add(wp, 192)
                    a0 := add(a0, mul(mload(p), v))
                    a1 := add(a1, mul(mload(add(p, 32)), v))
                    a2 := add(a2, mul(mload(add(p, 64)), v))
                }
                {
                    let v := and(shr(128, x), 0xffffffff)
                    let p := add(wp, 288)
                    a0 := add(a0, mul(mload(p), v))
                    a1 := add(a1, mul(mload(add(p, 32)), v))
                    a2 := add(a2, mul(mload(add(p, 64)), v))
                }
                {
                    let v := and(shr(96, x), 0xffffffff)
                    let p := add(wp, 384)
                    a0 := add(a0, mul(mload(p), v))
                    a1 := add(a1, mul(mload(add(p, 32)), v))
                    a2 := add(a2, mul(mload(add(p, 64)), v))
                }
                {
                    let v := and(shr(64, x), 0xffffffff)
                    let p := add(wp, 480)
                    a0 := add(a0, mul(mload(p), v))
                    a1 := add(a1, mul(mload(add(p, 32)), v))
                    a2 := add(a2, mul(mload(add(p, 64)), v))
                }
                {
                    let v := and(shr(32, x), 0xffffffff)
                    let p := add(wp, 576)
                    a0 := add(a0, mul(mload(p), v))
                    a1 := add(a1, mul(mload(add(p, 32)), v))
                    a2 := add(a2, mul(mload(add(p, 64)), v))
                }
                {
                    let v := and(x, 0xffffffff)
                    let p := add(wp, 672)
                    a0 := add(a0, mul(mload(p), v))
                    a1 := add(a1, mul(mload(add(p, 32)), v))
                    a2 := add(a2, mul(mload(add(p, 64)), v))
                }
                wp := add(wp, 768)
            }
            for { let i := 0 } lt(i, and(n, 7)) { i := add(i, 1) } {
                let v := shr(224, calldataload(add(src, shl(2, i))))
                let p := add(wp, mul(96, i))
                a0 := add(a0, mul(mload(p), v))
                a1 := add(a1, mul(mload(add(p, 32)), v))
                a2 := add(a2, mul(mload(add(p, 64)), v))
            }
            mstore(acc, a0)
            mstore(add(acc, 32), a1)
            mstore(add(acc, 64), a2)
        }
    }

    function reduceWide(uint256[3] memory acc) internal pure returns (uint256 r) {
        assembly {
            let q := 2130706433
            let F := 0x1fffffffffffffffffffff
            let a0 := mload(acc)
            let a1 := mload(add(acc, 32))
            let a2 := mload(add(acc, 64))
            r := or(or(mod(and(a0, F), q), shl(32, mod(and(shr(85, a0), F), q))), shl(64, mod(shr(170, a0), q)))
            r := or(r, or(or(shl(96, mod(and(a1, F), q)), shl(128, mod(and(shr(85, a1), F), q))), shl(160, mod(shr(170, a1), q))))
            r := or(r, or(shl(192, mod(and(a2, F), q)), shl(224, mod(shr(85, a2), q))))
        }
    }

    function batchInverse(uint256[] memory v) internal view returns (uint256[] memory out) {
        uint256 n = v.length;
        out = new uint256[](n);
        uint256 acc = 1;
        for (uint256 i = 0; i < n; i++) {
            out[i] = acc;
            acc = KB8.mul(acc, v[i]);
        }
        uint256 inv = KB8.inv(acc);
        for (uint256 i = n; i > 0; i--) {
            out[i - 1] = KB8.mul(out[i - 1], inv);
            inv = KB8.mul(inv, v[i - 1]);
        }
    }

    function siblingCount(Ctx memory c, uint256 o) internal pure returns (bool, uint256) {
        if (o + 2 > c.len) return (false, 0);
        uint256 n = ld16(c, o);
        if (o + 2 + 32 * n > c.len) return (false, 0);
        return (true, n);
    }

    struct Batch {
        bytes32 root;
        uint256 nm;
        uint256 wd;
        uint256 col;
        // Ladder position of the matrix's claims at zeta g; 0 when it opens at zeta only.
        uint256 colN;
        uint256 scratch;
        uint256[] w;
        uint256[3][] accZ;
        uint256[3][] accN;
    }

    // One input batch: nm matrices of width wd (random-codeword columns included), all of height 2^H,
    // whose columns start at position col of the alpha ladder (and, for the trace, again at colN for its
    // opening at zeta g). Per query the calldata holds each row followed by its salt, which is the leaf
    // preimage order.
    function openBatch(Ctx memory c, Batch memory bt) internal pure returns (bool) {
        uint256 per = bt.nm * (bt.wd + SALT);
        bytes32[] memory leaf = new bytes32[](QUERIES);
        uint256 start = c.base + c.cursor;
        uint256 scratch = bt.scratch;
        for (uint256 q = 0; q < QUERIES; q++) {
            uint256 blk = start + 4 * per * q;
            if (!montBlock(blk, per, scratch)) return false;
            bytes32 h;
            assembly {
                h := keccak256(scratch, shl(2, per))
            }
            leaf[q] = h;
            for (uint256 m = 0; m < bt.nm; m++) {
                dotWide(bt.w, bt.col + m * bt.wd, blk + 4 * m * (bt.wd + SALT), bt.wd, bt.accZ[q]);
            }
            if (bt.colN != 0) dotWide(bt.w, bt.colN, blk, bt.wd, bt.accN[q]);
        }
        uint256 o = c.cursor + 4 * per * QUERIES;
        (bool ok, uint256 nsib) = siblingCount(c, o);
        if (!ok || !merklePow2(bt.root, H, c.indices, leaf, c.base + o + 2, nsib)) return false;
        c.cursor = o + 2 + 32 * nsib;
        return true;
    }

    // TwoAdicFriPcs input openings (p3_fri::verifier::open_inputs): authenticate every batch (random,
    // trace, quotient), then combine each query's opened rows into its reduced opening.
    function openInputs(Ctx memory c) internal view returns (bool) {
        Batch memory bt;
        uint256 sz;
        uint256 sn;
        (bt.w, sz, sn) = ladder(c.pcsAlpha, c.claims);
        bt.accZ = new uint256[3][](QUERIES);
        bt.accN = new uint256[3][](QUERIES);
        {
            bytes memory buf = new bytes(4 * (WD + SALT) + 32);
            uint256 sp;
            assembly {
                sp := add(buf, 32)
            }
            bt.scratch = sp;
        }
        (bt.root, bt.nm, bt.wd, bt.col, bt.colN) = (ldWord(c, O_RAND), 1, 16, 0, 0);
        if (!openBatch(c, bt)) return false;
        (bt.root, bt.nm, bt.wd, bt.col, bt.colN) = (ldWord(c, O_TRACE), 1, WD, 16, N_START);
        if (!openBatch(c, bt)) return false;
        (bt.root, bt.nm, bt.wd, bt.col, bt.colN) = (ldWord(c, O_QUOT), CHUNKS, 16, N_END, 0);
        if (!openBatch(c, bt)) return false;
        uint256 zetaNext = KB8.mulBase(c.zeta, SpendConstants.TRACE_GEN);
        uint256[] memory den = new uint256[](2 * QUERIES);
        c.topTable = revPowTable(c.gens[H], H);
        for (uint256 q = 0; q < QUERIES; q++) {
            uint256 x = mulmod(SpendConstants.GENERATOR, revPow(c.topTable, c.indices[q]), P);
            den[2 * q] = KB8.subBase(c.zeta, x);
            den[2 * q + 1] = KB8.subBase(zetaNext, x);
            if (den[2 * q] == 0 || den[2 * q + 1] == 0) return false;
        }
        uint256[] memory dinv = batchInverse(den);
        c.folded = new uint256[](QUERIES);
        for (uint256 q = 0; q < QUERIES; q++) {
            uint256 roZ = KB8.mul(KB8.sub(sz, reduceWide(bt.accZ[q])), dinv[2 * q]);
            uint256 roN = KB8.mul(KB8.sub(sn, reduceWide(bt.accN[q])), dinv[2 * q + 1]);
            c.folded[q] = KB8.add(roZ, roN);
        }
        return true;
    }

    // ---------------------------------------------------------------- FRI

    // TwoAdicFriFolding::fold_row for arity 2 and 4. The parent sits at index idx of a domain of 2^logf
    // points; the group's points are s * w^j with s = g_(logf + a)^rev(idx, logf), listed bit-reversed.
    // The caller passes s^-1.
    function foldRow(Ctx memory c, uint256 a, uint256 sInv, uint256 beta, uint256[] memory ev) internal pure returns (uint256) {
        if (a == 1) {
            // (lo + hi) / 2 + (lo - hi) * beta / (2 s)
            uint256 even = KB8.mulBase(KB8.add(ev[0], ev[1]), INV2);
            uint256 odd = KB8.mulBase(KB8.mul(KB8.sub(ev[0], ev[1]), beta), mulmod(INV2, sInv, P));
            return KB8.add(even, odd);
        }
        require(a == 2, "unsupported arity");
        return fold4(ev, KB8.mulBase(beta, sInv), c.gens[2]);
    }

    // Interpolant through (s w^m, y_m), w = g_2, y = (ev0, ev2, ev1, ev3) (the points are listed
    // bit-reversed): d_k = (1/4) sum_m y_m w^-mk and the value at beta is sum_k d_k t^k with t = beta / s.
    // With w^2 = -1: d1 = (y0 - y2) - w (y1 - y3) and d3 = (y0 - y2) + w (y1 - y3).
    function fold4(uint256[] memory ev, uint256 t, uint256 w4) internal pure returns (uint256) {
        uint256 s02 = KB8.add(ev[0], ev[1]);
        uint256 s13 = KB8.add(ev[2], ev[3]);
        uint256 e02 = KB8.sub(ev[0], ev[1]);
        uint256 wo = KB8.mulBase(KB8.sub(ev[2], ev[3]), w4);
        uint256 v = KB8.add(KB8.mul(KB8.add(e02, wo), t), KB8.sub(s02, s13));
        v = KB8.add(KB8.mul(v, t), KB8.sub(e02, wo));
        v = KB8.add(KB8.mul(v, t), KB8.add(s02, s13));
        return KB8.mulBase(v, INV4);
    }

    struct Round {
        uint256 r;
        uint256 a;
        uint256 ar;
        uint256 logf;
        uint256 o;
        uint256 scratch;
        uint256[] invTable;
    }

    // One query of one commit round: its row is the folded value at its slot and the opened siblings
    // elsewhere. The row (ExtensionMmcs flattens each element to its 8 coefficients) and its salt are
    // the leaf preimage; the row folds to the parent's value.
    function friQuery(Ctx memory c, Round memory rd, uint256 q, uint256[] memory idx, bytes32[] memory leaf)
        internal
        pure
        returns (bool)
    {
        uint256 iig = idx[q] & (rd.ar - 1);
        uint256[] memory ev = new uint256[](rd.ar);
        uint256 sib = 0;
        for (uint256 j = 0; j < rd.ar; j++) {
            if (j == iig) {
                ev[j] = c.folded[q];
            } else {
                ev[j] = ldExt(c, rd.o + 32 * sib);
                if (!KB8.isCanonical(ev[j])) return false;
                sib++;
            }
            montExt(ev[j], rd.scratch + 32 * j);
        }
        rd.o += 32 * (rd.ar - 1);
        if (!montBlock(c.base + rd.o, SALT, rd.scratch + 32 * rd.ar)) return false;
        rd.o += 4 * SALT;
        leaf[q] = keccakAt(rd.scratch, 32 * rd.ar + 4 * SALT);
        idx[q] >>= rd.a;
        c.folded[q] = foldRow(c, rd.a, revPow(rd.invTable, idx[q]), c.betas[rd.r], ev);
        return true;
    }

    function keccakAt(uint256 ptr, uint256 len) internal pure returns (bytes32 h) {
        assembly {
            h := keccak256(ptr, len)
        }
    }

    // One commit round: fold every query, then authenticate all rows against the round's commitment
    // (one matrix of width arity, height 2^logf).
    function friRound(Ctx memory c, uint256 r, uint256 logh, uint256[] memory idx) internal view returns (bool) {
        Round memory rd;
        rd.r = r;
        rd.a = (c.arities >> (4 * r)) & 0xf;
        rd.ar = 1 << rd.a;
        rd.logf = logh - rd.a;
        rd.o = c.cursor;
        {
            bytes memory buf = new bytes(32 * rd.ar + 4 * SALT + 32);
            uint256 sp;
            assembly {
                sp := add(buf, 32)
            }
            rd.scratch = sp;
        }
        // s^-1 = (g^-1)^rev(idx, logf) with g = g_(logf + a).
        rd.invTable = revPowTable(KB8.invBase(c.gens[rd.logf + rd.a]), rd.logf);
        bytes32[] memory leaf = new bytes32[](QUERIES);
        for (uint256 q = 0; q < QUERIES; q++) {
            if (!friQuery(c, rd, q, idx, leaf)) return false;
        }
        (bool ok, uint256 nsib) = siblingCount(c, rd.o);
        if (!ok || !merklePow2(ldWord(c, O_COMMITS + 32 * r), rd.logf, idx, leaf, c.base + rd.o + 2, nsib)) return false;
        c.cursor = rd.o + 2 + 32 * nsib;
        return true;
    }

    // p3_fri::verifier::verify_fri's query phase: fold every query to the final height and compare with
    // the final polynomial at the query's point.
    function fri(Ctx memory c) internal view returns (bool) {
        uint256[] memory idx = new uint256[](QUERIES);
        for (uint256 q = 0; q < QUERIES; q++) {
            idx[q] = c.indices[q];
        }
        uint256 logh = H;
        for (uint256 r = 0; r < c.rounds; r++) {
            if (!friRound(c, r, logh, idx)) return false;
            logh -= (c.arities >> (4 * r)) & 0xf;
        }
        if (logh != LOG_FINAL_HEIGHT) return false;
        for (uint256 q = 0; q < QUERIES; q++) {
            // x = g_H^rev(index, H) for the folded index, as verify_fri evaluates the final polynomial.
            if (finalEval(c.base + c.finalOffset, revPow(c.topTable, idx[q])) != c.folded[q]) return false;
        }
        return true;
    }

    // sum_i c_i x^i over the 16 final-polynomial coefficients at calldata address src, for a base x:
    // each coefficient spread two lanes per word (128 bits apart), scaled by x^i, summed unreduced
    // (below 2^66), reduced once.
    function finalEval(uint256 src, uint256 x) internal pure returns (uint256 r) {
        assembly {
            let q := 2130706433
            let M := 0xffffffff
            let a0 := 0
            let a1 := 0
            let a2 := 0
            let a3 := 0
            let xp := 1
            for { let i := 0 } lt(i, 16) { i := add(i, 1) } {
                let e := calldataload(add(src, shl(5, i)))
                a0 := add(a0, mul(or(and(e, M), shl(128, and(shr(128, e), M))), xp))
                a1 := add(a1, mul(or(and(shr(32, e), M), shl(128, and(shr(160, e), M))), xp))
                a2 := add(a2, mul(or(and(shr(64, e), M), shl(128, and(shr(192, e), M))), xp))
                a3 := add(a3, mul(or(and(shr(96, e), M), shl(128, shr(224, e))), xp))
                xp := mulmod(xp, x, q)
            }
            let L := 0xffffffffffffffffffffffffffffffff
            r := or(mod(and(a0, L), q), shl(128, mod(shr(128, a0), q)))
            r := or(r, or(shl(32, mod(and(a1, L), q)), shl(160, mod(shr(128, a1), q))))
            r := or(r, or(shl(64, mod(and(a2, L), q)), shl(192, mod(shr(128, a2), q))))
            r := or(r, or(shl(96, mod(and(a3, L), q)), shl(224, mod(shr(128, a3), q))))
        }
    }

    // ---------------------------------------------------------------- quotient and constraints

    // x^k * e in the extension (x^8 = 3).
    function mulX(uint256 e, uint256 k) internal pure returns (uint256) {
        if (k == 0) return e;
        uint256 up = (e << (32 * k));
        uint256 wrapped = e >> (32 * (8 - k));
        return up | KB8.mulBase(wrapped, 3);
    }

    function quotientAtZeta(Ctx memory c) internal pure returns (uint256 qv) {
        uint256[8] memory cs = SpendConstants.chunkShiftPow();
        uint256[8] memory ds = SpendConstants.chunkDenomInv();
        uint256[8] memory z;
        for (uint256 j = 0; j < CHUNKS; j++) {
            z[j] = KB8.subBase(KB8.mulBase(c.zp, cs[j]), 1);
        }
        for (uint256 i = 0; i < CHUNKS; i++) {
            uint256 zps = ds[i];
            for (uint256 j = 0; j < CHUNKS; j++) {
                if (j != i) zps = KB8.mul(zps, z[j]);
            }
            uint256 ch = 0;
            for (uint256 k = 0; k < 8; k++) {
                ch = KB8.add(ch, mulX(ldExt(c, O_QC + (8 * i + k) * 32), k));
            }
            qv = KB8.add(qv, KB8.mul(zps, ch));
        }
    }

    // The constraint folder's inputs at zeta: openings at zeta (tl) and zeta g (tn) as calldata
    // addresses, public values, periodic selectors and the row selectors.
    struct Fold {
        uint256 acc;
        uint256 alpha;
        uint256 tl;
        uint256 tn;
        uint256[] pv;
        uint256[8] per;
        uint256 first;
        uint256 trans;
    }

    // Periodic selectors at zeta: sum over the selector's rows r of L_r(zeta), with
    // L_r(zeta) = (g^r / N) (zeta^N - 1) / (zeta - g^r); and is_first_row = (zeta^N - 1) / (zeta - 1),
    // is_transition = zeta - g^-1 (unnormalized, as selectors_at_point). Every selector row is below 32.
    function selectors(Ctx memory c, Fold memory f) internal view {
        uint256[8] memory masks = SpendConstants.periodicMasks();
        uint256 used = 0;
        for (uint256 i = 0; i < NUM_PERIODIC; i++) {
            used |= masks[i];
        }
        require(used >> 32 == 0, "selector rows");
        uint256 n = 0;
        for (uint256 r = 0; r < 32; r++) {
            if ((used >> r) & 1 == 1) n++;
        }
        uint256[] memory den = new uint256[](n);
        uint256[] memory row = new uint256[](n);
        uint256[] memory wt = new uint256[](n);
        n = 0;
        uint256 gr = 1;
        for (uint256 r = 0; r < 32; r++) {
            if ((used >> r) & 1 == 1) {
                den[n] = KB8.subBase(c.zeta, gr);
                row[n] = r;
                wt[n] = mulmod(gr, SpendConstants.ROWS_INV, P);
                n++;
            }
            gr = mulmod(gr, SpendConstants.TRACE_GEN, P);
        }
        uint256[] memory inv = batchInverse(den);
        uint256 zh = KB8.subBase(c.zp, 1);
        for (uint256 k = 0; k < n; k++) {
            uint256 lr = KB8.mulBase(KB8.mul(zh, inv[k]), wt[k]);
            for (uint256 i = 0; i < NUM_PERIODIC; i++) {
                if ((masks[i] >> row[k]) & 1 == 1) f.per[i] = KB8.add(f.per[i], lr);
            }
            // Row 0 is a selector row; its inverse also gives is_first_row.
            if (row[k] == 0) f.first = KB8.mul(zh, inv[k]);
        }
        require((used & 1) == 1, "row 0");
        f.trans = KB8.subBase(c.zeta, SpendConstants.TRACE_GEN_INV);
    }

    function constraintsHold(Ctx memory c) internal view returns (bool) {
        Fold memory f;
        f.alpha = c.alpha;
        f.tl = c.base + O_TL;
        f.tn = c.base + O_TN;
        f.pv = c.pv;
        selectors(c, f);
        f.acc = Poseidon2Fold.fold(f.tl, f.alpha);
        extras(f);
        uint256 zh = KB8.subBase(c.zp, 1);
        return f.acc == KB8.mul(quotientAtZeta(c), zh);
    }

    // ---------------------------------------------------------------- the spend constraints

    // Columns after the permutation block (circuit/src/lib.rs).
    uint256 internal constant OUT0 = 148; // the permutation's output: the last 16 columns of the block
    uint256 internal constant C_W = 164;
    uint256 internal constant C_BIT = 172;
    uint256 internal constant C_AMT = 173;
    uint256 internal constant C_CARRY = 178;
    uint256 internal constant C_ACC = 182;
    uint256 internal constant C_BITS = 187;
    // Public values.
    uint256 internal constant PV_ASSET = 0;
    uint256 internal constant PV_V = 6;
    uint256 internal constant PV_FEE = 11;
    uint256 internal constant PV_NF = 16;
    uint256 internal constant PV_ROOT = 24;
    uint256 internal constant PV_CHANGE = 32;
    uint256 internal constant TWO26 = 1 << 26;

    function cur(Fold memory f, uint256 i) internal pure returns (uint256 v) {
        uint256 a = f.tl + 32 * i;
        assembly {
            v := calldataload(a)
        }
    }

    function nxt(Fold memory f, uint256 i) internal pure returns (uint256 v) {
        uint256 a = f.tn + 32 * i;
        assembly {
            v := calldataload(a)
        }
    }

    function outAt(Fold memory f, uint256 j) internal pure returns (uint256) {
        return cur(f, OUT0 + j);
    }

    // accumulator = accumulator * alpha + x, as VerifierConstraintFolder::assert_zero.
    function push(Fold memory f, uint256 x) internal pure {
        f.acc = KB8.add(KB8.mul(f.acc, f.alpha), x);
    }

    // The constraints after the permutation's, in the order SpendAir::eval emits them.
    function extras(Fold memory f) internal pure {
        // Booleans and carry ranges.
        uint256 x = cur(f, C_BIT);
        push(f, KB8.mul(x, KB8.subBase(x, 1)));
        for (uint256 i = 0; i < 5; i++) {
            x = cur(f, C_BITS + i);
            push(f, KB8.mul(x, KB8.subBase(x, 1)));
        }
        for (uint256 i = 0; i < 4; i++) {
            x = cur(f, C_CARRY + i);
            push(f, KB8.mul(KB8.mul(x, KB8.subBase(x, 1)), KB8.subBase(x, 2)));
        }
        // The spent amount is constant; the change bits accumulate.
        for (uint256 i = 0; i < 5; i++) {
            push(f, KB8.mul(f.trans, KB8.sub(nxt(f, C_AMT + i), cur(f, C_AMT + i))));
        }
        for (uint256 i = 0; i < 5; i++) {
            push(f, KB8.mul(f.first, KB8.sub(cur(f, C_ACC + i), cur(f, C_BITS + i))));
            uint256 a = cur(f, C_ACC + i);
            push(f, KB8.mul(f.trans, KB8.sub(KB8.sub(nxt(f, C_ACC + i), KB8.add(a, a)), nxt(f, C_BITS + i))));
        }
        valueRow(f);
        tagRow(f);
        leafRow(f);
        nullifierRow(f);
        pathRows(f);
        rootRow(f);
        changeValueRow(f);
        changeRow(f);
    }

    // Row 0: (asset, amount, 0); the value digest carries on.
    function valueRow(Fold memory f) internal pure {
        uint256 s = f.per[0];
        for (uint256 j = 0; j < 6; j++) push(f, KB8.mul(s, KB8.subBase(cur(f, j), f.pv[PV_ASSET + j])));
        for (uint256 i = 0; i < 5; i++) push(f, KB8.mul(s, KB8.sub(cur(f, 6 + i), cur(f, C_AMT + i))));
        for (uint256 j = 11; j < 16; j++) push(f, KB8.mul(s, cur(f, j)));
        for (uint256 j = 0; j < 8; j++) push(f, KB8.mul(s, KB8.sub(nxt(f, C_W + j), outAt(f, j))));
    }

    // Row 1: (rho || sk); the next row hashes (value || tag); rho carries on.
    function tagRow(Fold memory f) internal pure {
        uint256 s = f.per[1];
        for (uint256 j = 0; j < 8; j++) push(f, KB8.mul(s, KB8.sub(nxt(f, j), cur(f, C_W + j))));
        for (uint256 j = 0; j < 8; j++) push(f, KB8.mul(s, KB8.sub(nxt(f, 8 + j), outAt(f, j))));
        for (uint256 j = 0; j < 8; j++) push(f, KB8.mul(s, KB8.sub(nxt(f, C_W + j), cur(f, j))));
    }

    // Row 2: the commitment; the next row hashes (rho || commitment); the commitment carries on.
    function leafRow(Fold memory f) internal pure {
        uint256 s = f.per[2];
        for (uint256 j = 0; j < 8; j++) push(f, KB8.mul(s, KB8.sub(nxt(f, j), cur(f, C_W + j))));
        for (uint256 j = 0; j < 8; j++) push(f, KB8.mul(s, KB8.sub(nxt(f, 8 + j), outAt(f, j))));
        for (uint256 j = 0; j < 8; j++) push(f, KB8.mul(s, KB8.sub(nxt(f, C_W + j), outAt(f, j))));
    }

    // Row 3: the public nullifier; the next row is Merkle level 0 over the carried commitment.
    function nullifierRow(Fold memory f) internal pure {
        uint256 s = f.per[3];
        for (uint256 j = 0; j < 8; j++) push(f, KB8.mul(s, KB8.subBase(outAt(f, j), f.pv[PV_NF + j])));
        level(f, s, true);
    }

    // Merkle levels 1..19: the node is this row's output.
    function pathRows(Fold memory f) internal pure {
        level(f, f.per[4], false);
    }

    // left = node + bit (sibling - node), right = sibling + bit (node - sibling), bit and sibling on
    // the next row; the node is the carried commitment (level 0) or this row's output.
    function level(Fold memory f, uint256 s, bool fromCarry) internal pure {
        uint256 bit = nxt(f, C_BIT);
        for (uint256 j = 0; j < 8; j++) {
            uint256 o = fromCarry ? cur(f, C_W + j) : outAt(f, j);
            uint256 left = KB8.add(o, KB8.mul(bit, KB8.sub(nxt(f, C_W + j), o)));
            push(f, KB8.mul(s, KB8.sub(nxt(f, j), left)));
        }
        for (uint256 j = 0; j < 8; j++) {
            uint256 o = fromCarry ? cur(f, C_W + j) : outAt(f, j);
            uint256 sib = nxt(f, C_W + j);
            uint256 right = KB8.add(sib, KB8.mul(bit, KB8.sub(o, sib)));
            push(f, KB8.mul(s, KB8.sub(nxt(f, 8 + j), right)));
        }
    }

    function rootRow(Fold memory f) internal pure {
        uint256 s = f.per[5];
        for (uint256 j = 0; j < 8; j++) push(f, KB8.mul(s, KB8.subBase(outAt(f, j), f.pv[PV_ROOT + j])));
    }

    // v_i + fee_i + change_i + carry_(i-1) = amount_i + carry_i 2^26, carry_(-1) = carry_4 = 0.
    function changeValueRow(Fold memory f) internal pure {
        uint256 s = f.per[6];
        for (uint256 j = 0; j < 6; j++) push(f, KB8.mul(s, KB8.subBase(cur(f, j), f.pv[PV_ASSET + j])));
        for (uint256 j = 11; j < 16; j++) push(f, KB8.mul(s, cur(f, j)));
        for (uint256 j = 0; j < 8; j++) push(f, KB8.mul(s, KB8.sub(nxt(f, j), outAt(f, j))));
        for (uint256 i = 0; i < 5; i++) push(f, KB8.mul(s, KB8.sub(nxt(f, C_ACC + i), cur(f, 6 + i))));
        for (uint256 i = 0; i < 5; i++) {
            uint256 lhs = KB8.addBase(cur(f, 6 + i), addmod(f.pv[PV_V + i], f.pv[PV_FEE + i], P));
            if (i > 0) lhs = KB8.add(lhs, cur(f, C_CARRY + i - 1));
            uint256 rhs = cur(f, C_AMT + i);
            if (i < 4) rhs = KB8.add(rhs, KB8.mulBase(cur(f, C_CARRY + i), TWO26));
            push(f, KB8.mul(s, KB8.sub(lhs, rhs)));
        }
    }

    function changeRow(Fold memory f) internal pure {
        uint256 s = f.per[7];
        for (uint256 j = 0; j < 8; j++) push(f, KB8.mul(s, KB8.subBase(outAt(f, j), f.pv[PV_CHANGE + j])));
    }
}


// The permutation constraints of one spend row folded at zeta, as VerifierConstraintFolder runs them
// (one Poseidon2 permutation per row, width 16, S-box x^3 without registers, 4 + 20 + 4 rounds):
// accumulator = accumulator * alpha + constraint, in Plonky3's constraint order, from zero.
//
// The linear layers run on a wide form: an element is two words, coefficients 0..3 and 4..7, one per
// 64-bit field, left unreduced. The external layer only sees canonical inputs (after an S-box or at the
// start), so its fields stay below 2^37; the internal layer reduces its inputs, so sum + V_i s_i stays
// below 2^63. S-boxes and constraints use the packed form (KB8).
library Poseidon2Fold {
    struct State {
        uint256[16] lo;
        uint256[16] hi;
    }

    function load(uint256 tl, uint256 i) internal pure returns (uint256 v) {
        assembly {
            v := calldataload(add(tl, shl(5, i)))
        }
    }

    // Packed (8 x 32 bits) to wide (2 x 4 x 64 bits).
    function toWide(State memory st, uint256 i, uint256 e) internal pure {
        uint256 lo;
        uint256 hi;
        assembly {
            let M := 0xffffffff
            lo := or(or(and(e, M), shl(64, and(shr(32, e), M))), or(shl(128, and(shr(64, e), M)), shl(192, and(shr(96, e), M))))
            hi := or(or(and(shr(128, e), M), shl(64, and(shr(160, e), M))), or(shl(128, and(shr(192, e), M)), shl(192, shr(224, e))))
        }
        st.lo[i] = lo;
        st.hi[i] = hi;
    }

    // Wide (any 64-bit field values) to packed canonical.
    function fromWide(State memory st, uint256 i) internal pure returns (uint256 e) {
        uint256 lo = st.lo[i];
        uint256 hi = st.hi[i];
        assembly {
            let q := 2130706433
            let M := 0xffffffffffffffff
            e := or(or(mod(and(lo, M), q), shl(32, mod(and(shr(64, lo), M), q))), or(shl(64, mod(and(shr(128, lo), M), q)), shl(96, mod(shr(192, lo), q))))
            e := or(e, or(or(shl(128, mod(and(hi, M), q)), shl(160, mod(and(shr(64, hi), M), q))), or(shl(192, mod(and(shr(128, hi), M), q)), shl(224, mod(shr(192, hi), q)))))
        }
    }

    // M4 on each block of four, then every element plus the sum of its column (mds_light_permutation).
    function externalLayer(State memory st) internal pure {
        assembly {
            for { let h := 0 } lt(h, 2) { h := add(h, 1) } {
                // st holds pointers to its two 16-word arrays: lo, then hi.
                let b := mload(add(st, shl(5, h)))
                for { let c := 0 } lt(c, 512) { c := add(c, 128) } {
                    let p := add(b, c)
                    let x0 := mload(p)
                    let x1 := mload(add(p, 32))
                    let x2 := mload(add(p, 64))
                    let x3 := mload(add(p, 96))
                    let t01 := add(x0, x1)
                    let t23 := add(x2, x3)
                    let t0123 := add(t01, t23)
                    let t01123 := add(t0123, x1)
                    let t01233 := add(t0123, x3)
                    mstore(add(p, 96), add(t01233, add(x0, x0)))
                    mstore(add(p, 32), add(t01123, add(x2, x2)))
                    mstore(p, add(t01123, t01))
                    mstore(add(p, 64), add(t01233, t23))
                }
                for { let k := 0 } lt(k, 128) { k := add(k, 32) } {
                    let p := add(b, k)
                    let sm := add(add(mload(p), mload(add(p, 128))), add(mload(add(p, 256)), mload(add(p, 384))))
                    mstore(p, add(mload(p), sm))
                    mstore(add(p, 128), add(mload(add(p, 128)), sm))
                    mstore(add(p, 256), add(mload(add(p, 256)), sm))
                    mstore(add(p, 384), add(mload(add(p, 384)), sm))
                }
            }
        }
    }

    // sum + V_i s_i for every element: inputs reduced first, so V_i s_i < 2^62.
    function internalLayer(State memory st, uint256[16] memory diag) internal pure {
        assembly {
            let q := 2130706433
            let M := 0xffffffffffffffff
            let dg := diag
            for { let h := 0 } lt(h, 2) { h := add(h, 1) } {
                let b := mload(add(st, shl(5, h)))
                let sum := 0
                for { let i := 0 } lt(i, 512) { i := add(i, 32) } {
                    let w := mload(add(b, i))
                    w := or(or(mod(and(w, M), q), shl(64, mod(and(shr(64, w), M), q))), or(shl(128, mod(and(shr(128, w), M), q)), shl(192, mod(shr(192, w), q))))
                    mstore(add(b, i), w)
                    sum := add(sum, w)
                }
                for { let i := 0 } lt(i, 512) { i := add(i, 32) } {
                    mstore(add(b, i), add(sum, mul(mload(add(b, i)), mload(add(dg, i)))))
                }
            }
        }
    }

    function cube(uint256 x) internal pure returns (uint256) {
        return KB8.mul(KB8.mul(x, x), x);
    }

    function fullRound(State memory st, uint256[64] memory rc, uint256 r, uint256 tl, uint256 col, uint256 acc, uint256 alpha)
        internal
        pure
        returns (uint256)
    {
        for (uint256 i = 0; i < 16; i++) {
            toWide(st, i, cube(KB8.addBase(fromWide(st, i), rc[16 * r + i])));
        }
        externalLayer(st);
        for (uint256 i = 0; i < 16; i++) {
            uint256 post = load(tl, col + i);
            acc = KB8.add(KB8.mul(acc, alpha), KB8.sub(fromWide(st, i), post));
            toWide(st, i, post);
        }
        return acc;
    }

    function fold(uint256 tl, uint256 alpha) internal pure returns (uint256 acc) {
        State memory st;
        for (uint256 i = 0; i < 16; i++) {
            toWide(st, i, load(tl, i));
        }
        externalLayer(st);
        uint256 col = 16;
        uint256[64] memory rc = SpendConstants.rcInitial();
        for (uint256 r = 0; r < 4; r++) {
            acc = fullRound(st, rc, r, tl, col, acc, alpha);
            col += 16;
        }
        uint256[20] memory rp = SpendConstants.rcPartial();
        uint256[16] memory diag = SpendConstants.internalDiag();
        for (uint256 r = 0; r < 20; r++) {
            uint256 x = cube(KB8.addBase(fromWide(st, 0), rp[r]));
            uint256 post = load(tl, col);
            acc = KB8.add(KB8.mul(acc, alpha), KB8.sub(x, post));
            toWide(st, 0, post);
            col += 1;
            internalLayer(st, diag);
        }
        rc = SpendConstants.rcFinal();
        for (uint256 r = 0; r < 4; r++) {
            acc = fullRound(st, rc, r, tl, col, acc, alpha);
            col += 16;
        }
    }
}
